    <!-- Info -->
    <string name="about_version">Version %1$s (%2$d)</string>
    <string name="about_tagline">Backs up photos and videos in original quality to a USB stick or SD card and frees up space on the phone.</string>
    <string name="about_how">How it works</string>
    <string name="about_step1_title">Back up</string>
    <string name="about_step1">New photos and videos are copied bit-for-bit to the backup folder on the storage device.</string>
    <string name="about_step2_title">Verify</string>
    <string name="about_step2">Each copy is read back and compared with the original using a SHA-256 checksum.</string>
    <string name="about_step3_title">Compress</string>
    <string name="about_step3">If you want, the app replaces older originals on the phone with smaller versions.</string>
    <string name="about_step4_title">Restore</string>
    <string name="about_step4">Deleted or compressed files can be restored in original quality at any time.</string>
    <string name="about_safety">Safety</string>
    <string name="about_safety1">Only files that are provably backed up bit-for-bit are replaced – and only while the device is plugged in.</string>
    <string name="about_safety2">Android asks for your consent before anything is replaced; a dry run never replaces anything.</string>
    <string name="about_safety3">After replacing, the file is checked again; if anything goes wrong, the original is put back.</string>
